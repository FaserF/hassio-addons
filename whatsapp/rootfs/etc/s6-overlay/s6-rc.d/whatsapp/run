#!/usr/bin/with-contenv bashio

# shellcheck shell=bash
# shellcheck source=/dev/null
source /usr/lib/bashio/banner.sh

SCRIPTS_DIR="/etc/s6-overlay/s6-rc.d/whatsapp/scripts"

# 1. Environment and Token Setup
if [ -f "$SCRIPTS_DIR/00-env.sh" ]; then
    source "$SCRIPTS_DIR/00-env.sh"
else
    bashio::log.fatal "Environment setup script missing: $SCRIPTS_DIR/00-env.sh"
    exit 1
fi

# 2. Integration Management
if [ -f "$SCRIPTS_DIR/10-integration.sh" ]; then
    source "$SCRIPTS_DIR/10-integration.sh"
else
    bashio::log.fatal "Integration management script missing: $SCRIPTS_DIR/10-integration.sh"
    exit 1
fi

# 3. Pre-flight Diagnostics
if [ -f "$SCRIPTS_DIR/20-diagnostics.sh" ]; then
    source "$SCRIPTS_DIR/20-diagnostics.sh"
else
    bashio::log.fatal "Diagnostics script missing: $SCRIPTS_DIR/20-diagnostics.sh"
    exit 1
fi

bashio::app.print_banner
exec node index.js
