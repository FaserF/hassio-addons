{
  "name": "WhatsApp Gateway",
  "short_name": "WA Gateway",
  "description": "WhatsApp Web Gateway and Management Dashboard for Home Assistant",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111b21",
  "theme_color": "#00a884",
