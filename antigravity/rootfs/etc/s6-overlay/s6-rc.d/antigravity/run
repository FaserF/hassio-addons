#!/usr/bin/env bashio
# shellcheck disable=SC1091
set -e

# Read options using bashio
LOG_LEVEL=$(bashio::config 'log_level' 'info')
SCAN_INTERVAL=$(bashio::config 'scan_interval' '1800')
ADAPTIVE_POLLING=$(bashio::config 'adaptive_polling' 'true')
FAST_POLL_INTERVAL=$(bashio::config 'fast_poll_interval' '180')
IDLE_BACKOFF_INTERVAL=$(bashio::config 'idle_backoff_interval' '3600')

export ANTIGRAVITY_LOG_LEVEL="${LOG_LEVEL}"
export ANTIGRAVITY_SCAN_INTERVAL="${SCAN_INTERVAL}"
export ANTIGRAVITY_ADAPTIVE_POLLING="${ADAPTIVE_POLLING}"
export ANTIGRAVITY_FAST_POLL_INTERVAL="${FAST_POLL_INTERVAL}"
export ANTIGRAVITY_IDLE_BACKOFF_INTERVAL="${IDLE_BACKOFF_INTERVAL}"
export ANTIGRAVITY_OPTIONS_PATH="/data/options.json"
export ANTIGRAVITY_DATA_DIR="/data/antigravity"

bashio::log.info "Starting Antigravity Service on port 8199..."
bashio::log.info "Log Level: ${LOG_LEVEL} | Base Scan Interval: ${SCAN_INTERVAL}s | Adaptive: ${ADAPTIVE_POLLING}"

cd /usr/share/antigravity

exec python3 -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8199 \
    --log-level "${LOG_LEVEL}" \
    --app-dir /usr/share/antigravity
