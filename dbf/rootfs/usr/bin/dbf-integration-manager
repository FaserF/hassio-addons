#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant App: DBF (DB-Infoscreen)
# Manages the installation and update of the DB Infoscreen Integration
# ==============================================================================

if bashio::config.false 'auto_install_integration'; then
    bashio::log.info "Auto-installing/updating integration is disabled in configuration options."
    exit 0
fi

if ! bashio::fs.directory_exists "/config" && ! bashio::fs.directory_exists "/homeassistant"; then
    bashio::log.error "Could not find Home Assistant configuration directory."
    exit 1
fi

HA_CONFIG_ROOT=""
for path in "/config" "/homeassistant"; do
    if bashio::fs.directory_exists "$path"; then
        HA_CONFIG_ROOT="$path"
        break
    fi
done

INTEGRATION_SLUG="db_infoscreen"
INTEGRATION_DIR="${HA_CONFIG_ROOT}/custom_components/${INTEGRATION_SLUG}"
REPO_URL="https://github.com/FaserF/ha-db_infoscreen.git"

# Function to compare semantic versions
version_gt() {
    test "$(printf '%s\n' "$@" | sort -V | head -n 1)" != "$1"
}

# Helper to check GitHub status and diagnose failures
check_github_status() {
	local http_code="$1"
	local context="${2:-GitHub request}"

	case "$http_code" in
		000)
			bashio::log.warning "⚠️ $context: Connection timeout or unreachable network (HTTP 000)."
			;;
		401)
			bashio::log.warning "⚠️ $context: Authentication failed (HTTP 401 Unauthorized)."
			;;
		403)
			bashio::log.warning "⚠️ $context: Access forbidden or API rate limit exceeded (HTTP 403)."
			;;
		404)
			bashio::log.warning "⚠️ $context: Resource not found (HTTP 404)."
			;;
		429)
			bashio::log.warning "⚠️ $context: Too many requests / API rate limit exceeded (HTTP 429)."
			;;
		500|502|503|504)
			bashio::log.warning "⚠️ $context: GitHub server error (HTTP $http_code)."
			;;
		*)
			bashio::log.warning "⚠️ $context returned HTTP $http_code."
			;;
	esac

	# If server error (5xx) or connection timeout (000), check GitHub Status API
	if [[ "$http_code" =~ ^(000|500|502|503|504)$ ]]; then
		local gh_status
		gh_status=$(curl -s --connect-timeout 5 --max-time 10 "https://www.githubstatus.com/api/v2/status.json" 2>/dev/null || echo "")
		if [ -n "$gh_status" ]; then
			local indicator description
			indicator=$(echo "$gh_status" | jq -r '.status.indicator // "none"' 2>/dev/null || echo "none")
			description=$(echo "$gh_status" | jq -r '.status.description // empty' 2>/dev/null || echo "")
			if [ "$indicator" != "none" ] && [ -n "$description" ]; then
				bashio::log.error "🚨 GitHub Incident active: $description (Status: $indicator)"
				bashio::log.error "   Please check https://www.githubstatus.com for live status updates."
			fi
		fi
	fi
}

# Function to install/update integration
install_integration() {
    local TAG_NAME=$1
    local IS_UPDATE=$2

    bashio::log.info "Installing integration version: ${TAG_NAME:-Default Branch}..."

    rm -rf "/tmp/ha-db_infoscreen_install"
    mkdir -p "/tmp/ha-db_infoscreen_install"

    if [ -n "$TAG_NAME" ]; then
        local ZIP_URL="https://github.com/FaserF/ha-db_infoscreen/releases/download/${TAG_NAME}/db_infoscreen.zip"
        bashio::log.info "Downloading ${ZIP_URL}..."
        local dl_code
        dl_code=$(curl -L -s --connect-timeout 10 --max-time 60 -w "%{http_code}" -o "/tmp/db_infoscreen.zip" "${ZIP_URL}" 2>/dev/null)
        if [ "$dl_code" != "200" ] || [ ! -s "/tmp/db_infoscreen.zip" ]; then
            check_github_status "$dl_code" "Release download"
            bashio::log.error "❌ Failed to download release zip (HTTP $dl_code)."
            rm -rf "/tmp/ha-db_infoscreen_install"
            return 1
        fi
        mkdir -p "/tmp/ha-db_infoscreen_install/custom_components/${INTEGRATION_SLUG}"
        if ! unzip -q "/tmp/db_infoscreen.zip" -d "/tmp/ha-db_infoscreen_install/custom_components/${INTEGRATION_SLUG}"; then
            bashio::log.error "❌ Failed to unzip release package."
            rm -f "/tmp/db_infoscreen.zip"
            rm -rf "/tmp/ha-db_infoscreen_install"
            return 1
        fi
        rm -f "/tmp/db_infoscreen.zip"
    else
        # Disable interactive git prompts and bound clone duration
        export GIT_TERMINAL_PROMPT=0
        if ! timeout 60 git clone --depth 1 "${REPO_URL}" "/tmp/ha-db_infoscreen_install" > /dev/null 2>&1; then
            bashio::log.error "❌ Failed to clone repository (timed out or network error)."
            rm -rf "/tmp/ha-db_infoscreen_install"
            return 1
        fi
    fi

    if [ -d "/tmp/ha-db_infoscreen_install/custom_components/${INTEGRATION_SLUG}" ]; then
        # Stage into a temp directory for atomic swap
        STAGING_DIR=$(mktemp -d "${HA_CONFIG_ROOT}/custom_components/.${INTEGRATION_SLUG}.XXXXXX")
        cp -rf "/tmp/ha-db_infoscreen_install/custom_components/${INTEGRATION_SLUG}/." "${STAGING_DIR}/"

        if [ $? -ne 0 ] || [ ! -f "${STAGING_DIR}/manifest.json" ]; then
            bashio::log.error "❌ Copy to staging failed. Aborting to preserve existing installation."
            rm -rf "${STAGING_DIR}"
            rm -rf "/tmp/ha-db_infoscreen_install"
            return 1
        fi

        # Atomic swap: remove old, move staged into place
        if [ -d "$INTEGRATION_DIR" ]; then
            bashio::log.info "Removing old integration version..."
            rm -rf "$INTEGRATION_DIR"
        fi

        mkdir -p "${HA_CONFIG_ROOT}/custom_components"
        mv "${STAGING_DIR}" "${INTEGRATION_DIR}"

        if [ -d "$INTEGRATION_DIR" ]; then
            bashio::log.info "✅ Integration successfully installed/updated to $INTEGRATION_DIR"

            # Trigger persistent notification in HA to restart
            if [ "$IS_UPDATE" = "true" ]; then
                MSG="The DB Infoscreen integration has been updated to ${TAG_NAME}. Please restart Home Assistant."
                TITLE="DB Infoscreen Integration Updated"
            else
                MSG="The DB Infoscreen integration has been installed. Please restart Home Assistant."
                TITLE="DB Infoscreen Integration Installed"
            fi
            bashio::log.warning "RESTART HOME ASSISTANT to load the changes!"
            
            PAYLOAD=$(jq -n \
                --arg title "$TITLE" \
                --arg msg "$MSG" \
                '{title: $title, message: $msg, notification_id: "dbf_restart_required"}')

            curl -s --connect-timeout 5 --max-time 10 -X POST \
                -H "Authorization: Bearer $SUPERVISOR_TOKEN" \
                -H "Content-Type: application/json" \
                -d "$PAYLOAD" \
                http://supervisor/core/api/services/persistent_notification/create > /dev/null || true
        else
            bashio::log.error "❌ Atomic swap failed: $INTEGRATION_DIR does not exist."
        fi
    else
        bashio::log.error "❌ Could not find 'custom_components/${INTEGRATION_SLUG}' in the repository."
    fi
    rm -rf "/tmp/ha-db_infoscreen_install"
}

# Determine Channel (Edge vs Stable)
ADDON_INFO=$(curl -s --connect-timeout 5 --max-time 10 -H "Authorization: Bearer $SUPERVISOR_TOKEN" http://supervisor/addons/self/info)
SLUG=$(echo "$ADDON_INFO" | jq -r '.data.slug // empty')
NAME=$(echo "$ADDON_INFO" | jq -r '.data.name // empty')
VERSION=$(echo "$ADDON_INFO" | jq -r '.data.version // empty')
export ADDON_VERSION="${VERSION}"
export ADDON_SLUG="${SLUG}"

bashio::log.info "Channel Detection - Slug: ${SLUG}, Name: ${NAME}, Version: ${VERSION}"

if [[ "${SLUG}" == *"edge"* ]] || [[ "${NAME,,}" == *"edge"* ]] || [[ "${VERSION}" == *"dev"* ]] || [[ "${VERSION}" == *"git"* ]] || [[ "${VERSION}" =~ [0-9a-f]{7,40} ]]; then
    CHANNEL="edge"
    bashio::log.info "🟢 Edge/Dev channel detected. Will prefer Pre-releases."
else
    CHANNEL="stable"
    bashio::log.info "🔵 Stable channel detected."
fi

bashio::log.info "Fetching release information from GitHub..."
local rel_code
rel_code=$(curl -s --connect-timeout 10 --max-time 30 -w "%{http_code}" -A "HomeAssistant-Addon" -o /tmp/dbf_releases.json "https://api.github.com/repos/FaserF/ha-db_infoscreen/releases" 2>/dev/null || echo "000")

if [ "$rel_code" = "200" ] && [ -s /tmp/dbf_releases.json ]; then
    RELEASES_JSON=$(cat /tmp/dbf_releases.json)
else
    check_github_status "$rel_code" "Releases check"
    RELEASES_JSON="[]"
fi
rm -f /tmp/dbf_releases.json

TARGET_TAG=""
if [ "$RELEASES_JSON" != "[]" ]; then
    if [ "$CHANNEL" == "edge" ]; then
        TARGET_TAG=$(echo "$RELEASES_JSON" | jq -r '.[0].tag_name // empty')
    else
        # Stable channel: only consider non-prerelease releases
        TARGET_TAG=$(echo "$RELEASES_JSON" | jq -r 'map(select(.prerelease == false)) | .[0].tag_name // empty')
    fi

    if [ -z "$TARGET_TAG" ] && [ "$CHANNEL" == "stable" ]; then
        bashio::log.info "No stable (non-prerelease) release found. Skipping install/update on stable channel."
    fi
fi

if [ ! -d "$INTEGRATION_DIR" ]; then
    bashio::log.warning "Integration not found in $INTEGRATION_DIR"
    if [ -n "$TARGET_TAG" ]; then
        bashio::log.info "Target version (Initial Install): $TARGET_TAG"
        install_integration "$TARGET_TAG" "false"
    elif [ "$CHANNEL" == "edge" ]; then
        bashio::log.info "No releases found. Installing from Main branch (edge channel)..."
        install_integration "" "false"
    else
        bashio::log.info "No stable release available. Skipping initial install on stable channel."
    fi
else
    bashio::log.info "✅ Integration found at $INTEGRATION_DIR"
    bashio::log.info "Checking for updates..."

    if [ -f "$INTEGRATION_DIR/manifest.json" ]; then
        CURRENT_VERSION=$(jq -r '.version' "$INTEGRATION_DIR/manifest.json")
        bashio::log.info "Current Version: $CURRENT_VERSION"
        
        UPDATE_NEEDED="false"

        if [ -n "$TARGET_TAG" ]; then
             curr=$(echo "$CURRENT_VERSION" | sed 's/^v//')
             targ=$(echo "$TARGET_TAG" | sed 's/^v//')

             if [ "$curr" != "$targ" ]; then
                 if version_gt "$targ" "$curr"; then
                     bashio::log.info "Update Available: $targ > $curr"
                     UPDATE_NEEDED="true"
                 else
                     if version_gt "$curr" "$targ"; then
                         bashio::log.info "Current version ($curr) is newer than target ($targ)."
                     else
                         bashio::log.info "Current version ($curr) is equal to target ($targ)."
                     fi
                 fi
             else
                 bashio::log.info "Current version ($curr) matches target ($targ)."
             fi
        elif [ "$RELEASES_JSON" != "[]" ]; then
             bashio::log.warning "Could not determine target tag from GitHub releases."
        fi

        if [ "$UPDATE_NEEDED" == "true" ]; then
             bashio::log.info "⬆️  Auto-updating to $TARGET_TAG..."
             install_integration "$TARGET_TAG" "true"
        else
             bashio::log.info "✨ Integration is up to date."
        fi
     else
         bashio::log.warning "Manifest not found. Cannot check version. Reinstalling..."
         if [ -n "$TARGET_TAG" ]; then
             install_integration "$TARGET_TAG" "true"
         elif [ "$CHANNEL" == "edge" ]; then
             install_integration "" "true"
         else
             bashio::log.info "No stable release available. Skipping reinstall on stable channel."
         fi
     fi
fi

# Register discovery info in Supervisor
bashio::log.info "Registering discovery info in Supervisor for slug: $SLUG..."
DISCOVERY_RESPONSE=$(curl -s -w "\nHTTP_STATUS:%{http_code}" -X POST \
  -H "Authorization: Bearer $SUPERVISOR_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"service\":\"db_infoscreen\",\"config\":{\"addon\":\"$SLUG\"}}" \
  http://supervisor/discovery)
bashio::log.info "Supervisor discovery response: $DISCOVERY_RESPONSE"
