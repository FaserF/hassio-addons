#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

bashio::log.info "Initializing Paseo AI Code Studio..."

# Read configuration options
OMNIROUTE_URL=$(bashio::config 'omniroute_url')
OMNIROUTE_API_KEY=$(bashio::config 'omniroute_api_key')
MODEL=$(bashio::config 'model')
SMALL_MODEL=$(bashio::config 'small_model')
WORKSPACE=$(bashio::config 'workspace')
LOG_LEVEL=$(bashio::config 'log_level')
USER_MAX_MEM=$(bashio::config 'max_memory_mb')
CPU_PRIORITY=$(bashio::config 'cpu_priority')

[ -z "${WORKSPACE}" ] && WORKSPACE="/config"
[ -z "${MODEL}" ] && MODEL="omniroute/coding-cascade"
[ -z "${SMALL_MODEL}" ] && SMALL_MODEL="omniroute/fast-cascade"
[ -z "${OMNIROUTE_URL}" ] && OMNIROUTE_URL="https://omniroute.fabiseitz.de/v1"
[ -z "${USER_MAX_MEM}" ] && USER_MAX_MEM=0
[ -z "${CPU_PRIORITY}" ] && CPU_PRIORITY="low"

# -----------------------------------------------------------------------------
# Hardware Resource Protection & Dynamic Sizing
# -----------------------------------------------------------------------------
TOTAL_MEM_KB=0
if [ -f /proc/meminfo ]; then
    TOTAL_MEM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
fi
TOTAL_MEM_MB=$((TOTAL_MEM_KB / 1024))
if [ "${TOTAL_MEM_MB}" -le 0 ]; then
    TOTAL_MEM_MB=4096
fi

ALLOCATED_MEM_MB=1024
if [ "${USER_MAX_MEM}" -gt 0 ]; then
    SAFE_CEILING=$((TOTAL_MEM_MB - 1024))
    if [ "${SAFE_CEILING}" -lt 512 ]; then
        SAFE_CEILING=512
    fi
    if [ "${USER_MAX_MEM}" -gt "${SAFE_CEILING}" ]; then
        bashio::log.warning "Requested max_memory_mb (${USER_MAX_MEM}MB) leaves less than 1GB for Home Assistant OS!"
        bashio::log.warning "Clamping memory allocation to safe maximum: ${SAFE_CEILING}MB"
        ALLOCATED_MEM_MB="${SAFE_CEILING}"
    else
        ALLOCATED_MEM_MB="${USER_MAX_MEM}"
    fi
else
    # Dynamic auto-sizing based on total host RAM
    if [ "${TOTAL_MEM_MB}" -le 2048 ]; then
        ALLOCATED_MEM_MB=512
    elif [ "${TOTAL_MEM_MB}" -le 4096 ]; then
        ALLOCATED_MEM_MB=2048
    elif [ "${TOTAL_MEM_MB}" -le 8192 ]; then
        ALLOCATED_MEM_MB=4096
    else
        ALLOCATED_MEM_MB=$((TOTAL_MEM_MB * 75 / 100))
    fi
fi

# Determine Linux CPU Niceness to guarantee HA Core responsiveness
case "${CPU_PRIORITY}" in
    normal) NICE_VAL=0 ;;
    idle) NICE_VAL=19 ;;
    *) NICE_VAL=10 ;;
esac

bashio::log.info "Host RAM: ${TOTAL_MEM_MB}MB | Paseo Node.js heap limit: ${ALLOCATED_MEM_MB}MB"
bashio::log.info "CPU Scheduling Priority: ${CPU_PRIORITY} (nice ${NICE_VAL})"

# Persist environment variables for the paseo longrun service
mkdir -p /run/paseo
cat > /run/paseo/env <<EOF
NODE_HEAP_MB=${ALLOCATED_MEM_MB}
NICE_VAL=${NICE_VAL}
WORKSPACE=${WORKSPACE}
EOF

# Ensure workspace and configuration directories exist
mkdir -p "${WORKSPACE}"
mkdir -p /root/.config/opencode
mkdir -p /root/.paseo
mkdir -p /run/nginx

# Generate opencode.json configuration
cat > /root/.config/opencode/opencode.json <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${MODEL}",
  "small_model": "${SMALL_MODEL}",
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${OMNIROUTE_URL}",
        "apiKey": "${OMNIROUTE_API_KEY}"
      },
      "models": {
        "default": {
          "name": "OmniRoute Coding Cascade",
          "id": "coding-cascade"
        },
        "coding-cascade": {
          "name": "OmniRoute Coding Cascade",
          "id": "coding-cascade"
        },
        "fast-cascade": {
          "name": "OmniRoute Fast Cascade",
          "id": "fast-cascade"
        },
        "chat-cascade": {
          "name": "OmniRoute Chat Cascade",
          "id": "chat-cascade"
        },
        "reasoning": {
          "name": "OmniRoute Reasoning Latest",
          "id": "reasoning-latest"
        },
        "gemini-flash-latest": {
          "name": "OmniRoute Gemini Flash Latest",
          "id": "gemini-flash-latest"
        },
        "claude-latest": {
          "name": "OmniRoute Claude Sonnet Latest",
          "id": "claude-sonnet-latest"
        }
      }
    }
  },
  "instructions": [
    "You are Paseo AI Code Studio operating natively inside Home Assistant OS.",
    "Your root workspace is ${WORKSPACE}, containing the Home Assistant configuration and automation files.",
    "When modifying automations, scripts, or configuration files, preserve existing comments and formatting.",
    "Ensure all YAML syntax is valid and conforms to Home Assistant schema standards before saving changes."
  ]
}
EOF

# Generate Nginx ingress reverse proxy configuration
mkdir -p /etc/nginx/conf.d
cat > /etc/nginx/conf.d/ingress.conf <<'EOF'
server {
    listen 8099 default_server;
    server_name _;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:6767;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
EOF

bashio::log.info "Paseo initialization completed successfully."
