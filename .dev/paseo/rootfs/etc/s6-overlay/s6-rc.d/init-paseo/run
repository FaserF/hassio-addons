#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

bashio::log.info "Initializing Paseo AI Code Studio..."

# Read configuration options
OMNIROUTE_URL=$(bashio::config 'omniroute_url')
OMNIROUTE_API_KEY=$(bashio::config 'omniroute_api_key')
MODEL=$(bashio::config 'model')
SMALL_MODEL=$(bashio::config 'small_model')
WORKSPACE=$(bashio::config 'workspace')
LOG_LEVEL=$(bashio::config 'log_level')
USER_MAX_MEM=$(bashio::config 'max_memory_mb')
CPU_PRIORITY=$(bashio::config 'cpu_priority')

[ -z "${WORKSPACE}" ] && WORKSPACE="/config"
[ -z "${MODEL}" ] && MODEL="omniroute/coding-cascade"
[ -z "${SMALL_MODEL}" ] && SMALL_MODEL="omniroute/fast-cascade"
[ -z "${OMNIROUTE_URL}" ] && OMNIROUTE_URL="https://omniroute.fabiseitz.de/v1"
[ -z "${USER_MAX_MEM}" ] && USER_MAX_MEM=0
[ -z "${CPU_PRIORITY}" ] && CPU_PRIORITY="low"

# -----------------------------------------------------------------------------
# Hardware Resource Protection & Dynamic Sizing
# -----------------------------------------------------------------------------
TOTAL_MEM_KB=0
if [ -f /proc/meminfo ]; then
    TOTAL_MEM_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
fi
TOTAL_MEM_MB=$((TOTAL_MEM_KB / 1024))
if [ "${TOTAL_MEM_MB}" -le 0 ]; then
    TOTAL_MEM_MB=4096
fi

ALLOCATED_MEM_MB=1024
if [ "${USER_MAX_MEM}" -gt 0 ]; then
    SAFE_CEILING=$((TOTAL_MEM_MB - 1024))
    if [ "${SAFE_CEILING}" -lt 512 ]; then
        SAFE_CEILING=512
    fi
    if [ "${USER_MAX_MEM}" -gt "${SAFE_CEILING}" ]; then
        bashio::log.warning "Requested max_memory_mb (${USER_MAX_MEM}MB) leaves less than 1GB for Home Assistant OS!"
        bashio::log.warning "Clamping memory allocation to safe maximum: ${SAFE_CEILING}MB"
        ALLOCATED_MEM_MB="${SAFE_CEILING}"
    else
        ALLOCATED_MEM_MB="${USER_MAX_MEM}"
    fi
else
    # Dynamic auto-sizing based on total host RAM
    if [ "${TOTAL_MEM_MB}" -le 2048 ]; then
        ALLOCATED_MEM_MB=512
    elif [ "${TOTAL_MEM_MB}" -le 4096 ]; then
        ALLOCATED_MEM_MB=2048
    elif [ "${TOTAL_MEM_MB}" -le 8192 ]; then
        ALLOCATED_MEM_MB=4096
    else
        ALLOCATED_MEM_MB=$((TOTAL_MEM_MB * 75 / 100))
    fi
fi

# Determine Linux CPU Niceness to guarantee HA Core responsiveness
case "${CPU_PRIORITY}" in
    normal) NICE_VAL=0 ;;
    idle) NICE_VAL=19 ;;
    *) NICE_VAL=10 ;;
esac

bashio::log.info "Host RAM: ${TOTAL_MEM_MB}MB | Paseo Node.js heap limit: ${ALLOCATED_MEM_MB}MB"
bashio::log.info "CPU Scheduling Priority: ${CPU_PRIORITY} (nice ${NICE_VAL})"

# Persist environment variables for the paseo longrun service
mkdir -p /run/paseo
cat > /run/paseo/env <<EOF
NODE_HEAP_MB=${ALLOCATED_MEM_MB}
NICE_VAL=${NICE_VAL}
WORKSPACE=${WORKSPACE}
PASEO_HOSTNAMES=true
PASEO_ALLOWED_HOSTS=true
EOF

# Ensure workspace and configuration directories exist
mkdir -p "${WORKSPACE}"
mkdir -p /root/.config/opencode
mkdir -p /root/.paseo/projects
mkdir -p /run/nginx

# Ensure persistent server-id exists
if [ ! -f /root/.paseo/server-id ]; then
    RAND_SID=$(tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 12 || echo "EGVu9yecHzd1")
    echo "srv_${RAND_SID}" > /root/.paseo/server-id
fi

# Pre-register Home Assistant workspace project if not yet configured
NOW_ISO=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")
if [ ! -f /root/.paseo/projects/projects.json ]; then
    cat > /root/.paseo/projects/projects.json <<EOF
[
  {
    "projectId": "prj_config_ha",
    "rootPath": "${WORKSPACE}",
    "kind": "git",
    "displayName": "config",
    "projectKey": null,
    "customName": "Home Assistant Config",
    "customIconRevision": null,
    "createdAt": "${NOW_ISO}",
    "updatedAt": "${NOW_ISO}",
    "archivedAt": null
  }
]
EOF
fi

if [ ! -f /root/.paseo/projects/workspaces.json ]; then
    cat > /root/.paseo/projects/workspaces.json <<EOF
[
  {
    "workspaceId": "wks_config_ha",
    "projectId": "prj_config_ha",
    "cwd": "${WORKSPACE}",
    "kind": "local_checkout",
    "displayName": "master",
    "title": "Home Assistant",
    "branch": "master",
    "worktreeRoot": "${WORKSPACE}",
    "baseBranch": null,
    "isPaseoOwnedWorktree": false,
    "mainRepoRoot": null,
    "createdAt": "${NOW_ISO}",
    "updatedAt": "${NOW_ISO}",
    "archivedAt": null,
    "autoArchivedChangeRequestUrl": null,
    "pinnedAt": null
  }
]
EOF
fi

# Determine daemon listen address based on remote_access
LISTEN_HOST="0.0.0.0"
if ! bashio::config.true 'remote_access'; then
    LISTEN_HOST="127.0.0.1"
fi

# Generate Paseo daemon configuration
cat > /root/.paseo/config.json <<EOF
{
  "version": 1,
  "app": {
    "baseUrl": "https://code.fabiseitz.de"
  },
  "daemon": {
    "listen": "${LISTEN_HOST}:6767",
    "hostnames": true,
    "trustedProxies": true,
    "cors": {
      "allowedOrigins": [
        "*"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "features": {
    "webUi": {
      "enabled": true
    }
  }
}
EOF

# Check if Add-on Developer Recommendations (Multi-Agent suite) is requested
DEVELOPER_RECOMMENDATIONS=false
if bashio::config.true 'developer_recommendations' || bashio::config.true 'oracle_cloud_preset'; then
    DEVELOPER_RECOMMENDATIONS=true
    bashio::log.info "Activating Add-on Developer Recommendations (supervisor, coder, reviewer, explorer, searcher, tester, browser-qa, security-auditor)..."
fi

# Generate opencode.json configuration
if [ "${DEVELOPER_RECOMMENDATIONS}" = "true" ]; then
cat > /root/.config/opencode/opencode.json <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${MODEL}",
  "small_model": "${SMALL_MODEL}",
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${OMNIROUTE_URL}",
        "apiKey": "${OMNIROUTE_API_KEY}"
      },
      "models": {
        "default": {
          "name": "OmniRoute Default (Coding Cascade)",
          "id": "coding-cascade"
        },
        "coding-cascade": {
          "name": "OmniRoute Coding Cascade",
          "id": "coding-cascade"
        },
        "fast-cascade": {
          "name": "OmniRoute Fast Cascade",
          "id": "fast-cascade"
        },
        "chat-cascade": {
          "name": "OmniRoute Chat Cascade",
          "id": "chat-cascade"
        },
        "reasoning": {
          "name": "OmniRoute Best Reasoning",
          "id": "reasoning-latest"
        },
        "gemini-flash-latest": {
          "name": "OmniRoute Gemini Flash Latest",
          "id": "gemini-flash-latest"
        },
        "gemini-flash-lite-latest": {
          "name": "OmniRoute Gemini Flash Lite Latest",
          "id": "gemini-flash-lite-latest"
        },
        "claude-latest": {
          "name": "OmniRoute Claude Latest",
          "id": "claude-sonnet-latest"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "remote",
      "url": "http://100.64.0.1:8931/mcp",
      "enabled": true
    },
    "mcphub": {
      "type": "remote",
      "url": "http://100.64.0.1:3000/mcp",
      "enabled": true
    },
    "openwiki": {
      "type": "local",
      "command": ["openwiki", "mcp", "--host", "opencode"],
      "enabled": true
    },
    "dell-paseo": {
      "type": "remote",
      "url": "http://100.64.0.3:6767/mcp/agents",
      "headers": {
        "Authorization": "Bearer ${OMNIROUTE_API_KEY}"
      },
      "enabled": true
    }
  },
  "agent": {
    "supervisor": {
      "mode": "primary",
      "description": "High-level strategic architect, planning tasks, decomposing objectives, coordinating specialized subagents, and enforcing end-to-end verification.",
      "model": "omniroute/reasoning"
    },
    "explorer": {
      "mode": "subagent",
      "description": "Fast code exploration, repository indexing, symbol search, and architectural retrieval using OmniRoute fast models",
      "model": "omniroute/fast-cascade",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "researcher": {
      "mode": "subagent",
      "description": "Fast research agent scanning documentation, APIs, and searching files using OmniRoute fast models",
      "model": "omniroute/fast-cascade",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "searcher": {
      "mode": "subagent",
      "description": "Targeted codebase search, file pattern finding, and structural inspection using OmniRoute fast models",
      "model": "omniroute/fast-cascade",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "description": "High accuracy code generation, multi-file refactoring, bugfixing, and Home Assistant automation/script editing using OmniRoute coding cascade",
      "model": "omniroute/coding-cascade"
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Deep reasoning code review, regression analysis, architecture verification, and schema checking using OmniRoute reasoning latest",
      "model": "omniroute/reasoning",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "tester": {
      "mode": "subagent",
      "description": "Unit/integration test execution, YAML syntax validation, and Home Assistant configuration verification using OmniRoute coding cascade",
      "model": "omniroute/coding-cascade"
    },
    "browser-qa": {
      "mode": "subagent",
      "description": "Dedicated visual inspection and browser verification subagent checking UI layouts and frontend cards",
      "model": "omniroute/gemini-flash-latest"
    },
    "security-auditor": {
      "mode": "subagent",
      "description": "Security & infrastructure auditor inspecting diffs for secret leaks, exposed credentials, and Home Assistant configuration security",
      "model": "omniroute/reasoning"
    }
  },
  "instructions": [
    "You are Jarvis Autonomous System Engineer operating natively inside Home Assistant OS with full Antigravity-grade multi-agent capabilities.",
    "Your root workspace is ${WORKSPACE}, containing the Home Assistant configuration, automations, scripts, blueprints, and custom components.",
    "Web search and fetch operations are intercepted and handled with deduplicated caching via OmniRoute /v1/search and /v1/web/fetch.",
    "On-demand MCP tools from MCPHub, Playwright, GitNexus, and OpenWiki are available through mcphub and openwiki integrations.",
    "When modifying automations, scripts, or configuration files, strictly preserve existing comments and formatting.",
    "Ensure all YAML syntax is valid and conforms to Home Assistant schema standards before saving changes."
  ]
}
EOF
else
cat > /root/.config/opencode/opencode.json <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "${MODEL}",
  "small_model": "${SMALL_MODEL}",
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${OMNIROUTE_URL}",
        "apiKey": "${OMNIROUTE_API_KEY}"
      },
      "models": {
        "default": {
          "name": "OmniRoute Coding Cascade",
          "id": "coding-cascade"
        },
        "coding-cascade": {
          "name": "OmniRoute Coding Cascade",
          "id": "coding-cascade"
        },
        "fast-cascade": {
          "name": "OmniRoute Fast Cascade",
          "id": "fast-cascade"
        },
        "chat-cascade": {
          "name": "OmniRoute Chat Cascade",
          "id": "chat-cascade"
        },
        "reasoning": {
          "name": "OmniRoute Reasoning Latest",
          "id": "reasoning-latest"
        },
        "gemini-flash-latest": {
          "name": "OmniRoute Gemini Flash Latest",
          "id": "gemini-flash-latest"
        },
        "gemini-flash-lite-latest": {
          "name": "OmniRoute Gemini Flash Lite Latest",
          "id": "gemini-flash-lite-latest"
        },
        "claude-latest": {
          "name": "OmniRoute Claude Sonnet Latest",
          "id": "claude-sonnet-latest"
        }
      }
    }
  },
  "instructions": [
    "You are Paseo AI Code Studio operating natively inside Home Assistant OS.",
    "Your root workspace is ${WORKSPACE}, containing the Home Assistant configuration and automation files.",
    "When modifying automations, scripts, or configuration files, preserve existing comments and formatting.",
    "Ensure all YAML syntax is valid and conforms to Home Assistant schema standards before saving changes."
  ]
}
EOF
fi

# Generate Nginx ingress reverse proxy configuration
mkdir -p /etc/nginx/conf.d
cat > /etc/nginx/conf.d/ingress.conf <<'EOF'
server {
    listen 8099 default_server;
    server_name _;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:6767;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host 127.0.0.1:6767;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;

        sub_filter_once off;
        sub_filter_types application/javascript text/javascript text/css application/json;
        sub_filter 'href="/' 'href="$http_x_ingress_path/';
        sub_filter 'src="/' 'src="$http_x_ingress_path/';
        sub_filter '"/_expo/' '"$http_x_ingress_path/_expo/';
        sub_filter "'/_expo/" "'$http_x_ingress_path/_expo/";
    }
}
EOF

# Patch Paseo Web UI bundle for Home Assistant Ingress routing and WebSockets
if [ -f /usr/local/bin/patch-paseo-ingress.py ]; then
    bashio::log.info "Adapting Paseo Web UI bundle for Home Assistant Ingress..."
    python3 /usr/local/bin/patch-paseo-ingress.py || bashio::log.warning "Failed to patch Paseo Web UI bundle for Ingress"
fi

bashio::log.info "Paseo initialization completed successfully."

