#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

# Load calculated hardware limits and priorities from initialization
if [ -f /run/paseo/env ]; then
    # shellcheck disable=SC1091
    source /run/paseo/env
fi

[ -z "${WORKSPACE}" ] && WORKSPACE="/config"
[ -z "${NODE_HEAP_MB}" ] && NODE_HEAP_MB=1024
[ -z "${NICE_VAL}" ] && NICE_VAL=10

mkdir -p "${WORKSPACE}"
cd "${WORKSPACE}"

# Configure Node.js memory ceiling and async worker threads
export NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB} ${NODE_OPTIONS:-}"
CORES=$(nproc 2>/dev/null || echo 4)
export UV_THREADPOOL_SIZE="${CORES}"

bashio::log.info "Starting Paseo Server on port 6767 (Workspace: ${WORKSPACE}, Heap Limit: ${NODE_HEAP_MB}MB, Nice: ${NICE_VAL})..."

# Launch with scheduling priority protection
EXEC_PREFIX=""
if command -v nice >/dev/null 2>&1; then
    EXEC_PREFIX="nice -n ${NICE_VAL}"
fi
if command -v ionice >/dev/null 2>&1; then
    EXEC_PREFIX="${EXEC_PREFIX} ionice -c 2 -n 5"
fi

if command -v paseo >/dev/null 2>&1; then
    exec ${EXEC_PREFIX} paseo serve --port 6767 --host 0.0.0.0
elif command -v opencode >/dev/null 2>&1; then
    exec ${EXEC_PREFIX} opencode serve --port 6767 --hostname 0.0.0.0
else
    exec ${EXEC_PREFIX} npx opencode-ai serve --port 6767 --hostname 0.0.0.0
fi
